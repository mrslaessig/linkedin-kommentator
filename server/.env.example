# Optional: als server/.env kopieren und anpassen.
# Ohne diese Datei nutzt der Server dein Claude-Abo über Claude Code.

# BACKEND=abo          # abo (Standard, über Claude Code) | api (mit API-Key)
# MODEL=               # leer = Standardmodell aus Claude Code, z. B. opus oder sonnet
# EFFORT=medium        # low | medium | high
# CLAUDE_BIN=          # Pfad zu Claude Code, falls es nicht gefunden wird
# PORT=8787            # Achtung: die Erweiterung erwartet 8787

# Nur für BACKEND=api:
# ANTHROPIC_API_KEY=sk-ant-...
