{
  "manifest_version": 3,
  "name": "LinkedIn Kommentator",
  "version": "1.1.0",
  "description": "Kommentar-Vorschläge für LinkedIn in deinem persönlichen Stil. Postet nie automatisch.",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:8787/*", "http://127.0.0.1:8787/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.linkedin.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
